    "whatIsHappening": { "type": "string" },
    "geographicScope": { "type": "string" },
    "communityReports": { "type": "array" },
    "officialEvidence": { "type": "array" },
    "findings": { "type": "array" },
    "possibleExplanations": { "type": "array" },
